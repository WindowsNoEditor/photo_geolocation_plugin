{
  "manifest_version": 2,
  "id": "github.windowsnoeditor.photo_geolocation_plugin",
  "version": "1.0.0",
  "name": "照片定位识别",
  "description": "群友发照片时，读取图片 EXIF 里的 GPS 定位信息，逆地理编码成中文地址，并 @ 发图人回复「请问是在xxx的xxx群友吗」。支持免费 OSM 或高德（需 key）。注意：QQ 发普通压缩图通常会抹掉 GPS，一般只有发原图/文件才带 GPS。通过 chat.receive.before_process 钩子实现，不改动核心源码。",
  "author": {
    "name": "WindowsNoEditor",
    "url": "https://github.com/windowsnoeditor"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/windowsnoeditor/photo_geolocation_plugin",
    "homepage": "https://github.com/windowsnoeditor/photo_geolocation_plugin",
    "documentation": "https://github.com/windowsnoeditor/photo_geolocation_plugin/blob/main/README.md",
    "issues": "https://github.com/windowsnoeditor/photo_geolocation_plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=9.0.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.custom"
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "map-pin"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
